# Copy to .env and protect it: chmod 600 .env
WEB_USERNAME=admin
WEB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
# RTSP listens on this HOST IP. Default: host-local only.\n# Set to a trusted LAN/VPN host IP only after firewalling TCP 8554.\nRTSP_BIND_IP=127.0.0.1\n# Optional: Home Assistant REST notifications; token is sensitive.
HA_URL=
HA_TOKEN=
