# Copy to .env and protect it: chmod 600 .env
WEB_USERNAME=admin
WEB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# RTSP is host-local by default. To allow a remote HA instance,
# set a specific trusted LAN/VPN address and firewall TCP 8554.
RTSP_BIND_IP=127.0.0.1

# Optional HA REST notifications (no Supervisor needed).
HA_URL=
HA_TOKEN=
