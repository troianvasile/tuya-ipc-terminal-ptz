# OPTIONAL example for a separately configured go2rtc instance used for
# video/listening in Home Assistant. The new HA microphone PTT integration
# does NOT require go2rtc's experimental TTS push endpoint.
#
# Put this under the streams: key of the go2rtc instance HA actually uses.
# Use a bridge IP/hostname reachable from inside the go2rtc container/process.
# Do not copy 172.17.0.1 or localhost from another installation.
# RTSP paths come from "tuya-ipc-terminal cameras list" / cameras.json.
streams:
  front_door_video:
    - rtsp://192.168.1.50:8554/Front_Door/sd
  nursery_video:
    - rtsp://192.168.1.50:8554/Nursery/sd

# The PTT aliases in configuration.yaml are independent of these stream
# names. The PTT backend opens its own RTSP backchannel.
# TTS/file injection remains unsupported.
